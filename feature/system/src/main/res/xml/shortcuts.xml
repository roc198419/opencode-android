<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher shortcuts, App Actions and direct-share targets (iOS: the static New Session quick
     action in Info.plist, OpenCodeShortcuts' App Shortcuts, and the share extension's
     IntentsSupported). targetPackage resolves to the application ID generated for each app variant. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- iOS UIApplicationShortcutItems: New Session, shown before first launch. -->
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ms_edit_square"
        android:shortcutId="new-session"
        android:shortcutLongLabel="@string/system_new_session"
        android:shortcutShortLabel="@string/system_new_session">
        <intent
            android:action="ai.opencode.mobilecode.SYSTEM_ACTION"
            android:targetClass="ai.opencode.feature.system.intents.SystemActionActivity"
            android:targetPackage="@string/system_application_id">
            <extra android:name="quickAction" android:value="ai.opencode.mobilecode.new-session" />
        </intent>
    </shortcut>

    <!-- Ask OpenCode (“Ask OpenCode”, “Send a message to OpenCode”, “Tell OpenCode”). -->
    <capability android:name="actions.intent.CREATE_MESSAGE">
        <intent
            android:targetClass="ai.opencode.feature.system.intents.AskOpenCodeActivity"
            android:targetPackage="@string/system_application_id">
            <parameter android:name="message.text" android:key="android.intent.extra.TEXT" />
        </intent>
    </capability>

    <!-- Start Voice Call, Background Call, New Session, Open Session (by feature name). -->
    <capability android:name="actions.intent.OPEN_APP_FEATURE">
        <intent
            android:action="ai.opencode.mobilecode.SYSTEM_ACTION"
            android:targetClass="ai.opencode.feature.system.intents.AppActionActivity"
            android:targetPackage="@string/system_application_id">
            <parameter android:name="feature" android:key="appFeature" />
        </intent>
    </capability>

    <!-- The share sheet's suggestions: sessions published as sharing shortcuts (ShareSuggestion). -->
    <share-target android:targetClass="ai.opencode.feature.system.share.ShareActivity">
        <data android:mimeType="text/*" />
        <data android:mimeType="image/*" />
        <data android:mimeType="video/*" />
        <data android:mimeType="audio/*" />
        <data android:mimeType="application/*" />
        <category android:name="ai.opencode.mobilecode.category.SHARE_SESSION" />
    </share-target>
</shortcuts>
